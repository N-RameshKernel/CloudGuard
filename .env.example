# Copy to .env and fill the Atlas and OAuth values. Never commit .env.
NODE_ENV=development
PORT=4000
APP_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:4000
MONGODB_URI=
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=
DEMO_MODE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:4000/api/v1/auth/microsoft/callback
NVD_API_KEY=
CLOUD_SCAN_CRON=*/15 * * * *
INTEL_SYNC_ENABLED=true
INTEL_SYNC_CRON=17 * * * *
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
ALLOWED_ORIGINS=http://127.0.0.1:5173
WEBHOOK_SIGNING_KEY=replace-with-an-independent-random-secret

